{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.content-sop/schemas/decision-log.schema.json",
  "title": "Decision and discussion timeline",
  "type": "object",
  "required": ["schema_version", "project_id", "required_stages", "events"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "project_id": {"type": "string"},
    "required_stages": {
      "type": "array",
      "items": {"enum": ["original_need", "new_problem", "attempt", "user_feedback", "decision", "rationale", "implementation_result", "acceptance_evidence", "unresolved"]},
      "uniqueItems": true,
      "minItems": 9
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sequence", "stage", "summary", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "sequence": {"type": "integer", "minimum": 1},
          "at": {"type": ["string", "null"]},
          "stage": {"enum": ["original_need", "new_problem", "attempt", "user_feedback", "decision", "rationale", "implementation_result", "acceptance_evidence", "unresolved"]},
          "summary": {"type": "string", "minLength": 1},
          "details": {"type": "string"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "supersedes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
