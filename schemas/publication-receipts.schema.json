{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.content-sop/schemas/publication-receipts.schema.json",
  "title": "Publication side-effect receipts",
  "type": "object",
  "required": ["schema_version", "project_id", "receipts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "platform", "action", "release_digest", "grant_id", "attempted_at", "status", "public_url", "external_id", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "platform": {"type": "string", "minLength": 1},
          "action": {"enum": ["public_publish", "update_publication", "delete_publication", "external_sync", "historical_import"]},
          "release_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "grant_id": {"type": ["string", "null"]},
          "attempted_at": {"type": "string", "format": "date-time"},
          "status": {"enum": ["succeeded", "failed", "unknown", "verified_existing"]},
          "public_url": {"type": ["string", "null"]},
          "external_id": {"type": ["string", "null"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
