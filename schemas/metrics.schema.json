{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.content-sop/schemas/metrics.schema.json",
  "title": "Publication metrics",
  "type": "object",
  "required": ["schema_version", "project_id", "collection_plan", "snapshots"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "project_id": {"type": "string"},
    "collection_plan": {
      "type": "object",
      "required": ["mode", "timezone", "checkpoints"],
      "properties": {
        "mode": {"enum": ["hybrid", "platform_api", "creator_backend", "public_page", "manual"]},
        "timezone": {"type": "string"},
        "checkpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "due_at", "required"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "due_at": {"type": ["string", "null"], "format": "date-time"},
              "required": {"type": "boolean"},
              "note": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "last_attempt_at": {"type": ["string", "null"], "format": "date-time"},
        "next_due_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "platform", "checkpoint", "collection_status", "captured_at", "attempted_at", "source", "evidence", "values", "error"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "platform": {"type": "string"},
          "checkpoint": {"type": "string", "minLength": 1},
          "collection_status": {"enum": ["not_collected", "captured", "partial", "unavailable", "failed"]},
          "captured_at": {"type": ["string", "null"], "format": "date-time"},
          "attempted_at": {"type": ["string", "null"], "format": "date-time"},
          "source": {"enum": ["platform_api", "creator_backend", "public_page", "manual", "unknown"]},
          "evidence": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "values": {
            "type": "object",
            "required": ["views", "likes", "favorites", "comments", "shares", "follower_change"],
            "properties": {
              "views": {"type": ["integer", "null"], "minimum": 0},
              "likes": {"type": ["integer", "null"], "minimum": 0},
              "favorites": {"type": ["integer", "null"], "minimum": 0},
              "comments": {"type": ["integer", "null"], "minimum": 0},
              "shares": {"type": ["integer", "null"], "minimum": 0},
              "follower_change": {"type": ["integer", "null"]}
            },
            "additionalProperties": false
          },
          "error": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
