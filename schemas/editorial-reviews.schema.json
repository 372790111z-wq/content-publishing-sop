{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.content-sop/schemas/editorial-reviews.schema.json",
  "title": "Per-deliverable editorial reviews",
  "type": "object",
  "required": ["schema_version", "project_id", "reviews"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string"},
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "deliverable_id", "platform", "status", "reviewed_at", "reviewer", "providers", "content_sha256", "policy_sha256", "profile_id", "profile_version", "rewrite_mode", "ai_audit", "checks", "findings", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "deliverable_id": {"type": "string", "minLength": 1},
          "platform": {"type": ["string", "null"]},
          "status": {"enum": ["pending", "verified", "failed"]},
          "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
          "reviewer": {"type": "string"},
          "providers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "content_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "policy_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "profile_id": {"type": ["string", "null"]},
          "profile_version": {"type": ["string", "null"]},
          "rewrite_mode": {"enum": ["none", "targeted", "structural"]},
          "ai_audit": {
            "type": "object",
            "required": ["pattern_hits", "category_hits", "uniform_structure"],
            "properties": {
              "pattern_hits": {"type": "integer", "minimum": 0},
              "category_hits": {"type": "integer", "minimum": 0},
              "uniform_structure": {"type": "boolean"}
            },
            "additionalProperties": false
          },
          "checks": {
            "type": "object",
            "required": ["fact_fidelity", "process_completeness", "prompt_integrity", "ai_trace", "author_voice", "platform_fit", "medium_fit"],
            "properties": {
              "fact_fidelity": {"enum": ["verified", "failed", "not_applicable"]},
              "process_completeness": {"enum": ["verified", "failed", "not_applicable"]},
              "prompt_integrity": {"enum": ["verified", "failed", "not_applicable"]},
              "ai_trace": {"enum": ["verified", "failed", "not_applicable"]},
              "author_voice": {"enum": ["verified", "failed", "not_applicable"]},
              "platform_fit": {"enum": ["verified", "failed", "not_applicable"]},
              "medium_fit": {"enum": ["verified", "failed", "not_applicable"]}
            },
            "additionalProperties": false
          },
          "findings": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
